{
  "name": "antares",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "engine:build": "cargo run --locked -p antares-build",
    "pretest": "npm run engine:build",
    "preweb:build": "npm run engine:build",
    "dev": "cargo tauri dev",
    "web:build": "node scripts/build-web.mjs",
    "web:dev": "npm run web:build && cargo run --locked --manifest-path web-api/Cargo.toml",
    "tauri": "cargo tauri",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --lib",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7"
  },
  "description": "Reproductor de música para Windows y Android",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hanyer001/Antares.git"
  },
  "engines": {
    "node": ">=22"
  }
}
