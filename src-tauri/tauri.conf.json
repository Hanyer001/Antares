{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antares",
  "mainBinaryName": "Antares",
  "version": "0.3.0",
  "identifier": "com.hanyer.antares",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Antares",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "maximized": true,
        "visible": false,
        "resizable": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Hanyer",
    "shortDescription": "Reproductor de música",
    "longDescription": "Reproductor de música ligero con listas, aleatorio inteligente y recomendaciones.",
    "copyright": "© 2026 Hanyer",
    "category": "Music",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ]
      }
    },
    "externalBin": [
      "binaries/yt-dlp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxRjg4NzA5MzI0MzRGQUQKUldTdFQwTXlDWWY0d1QvM05OTmRyN3Nhb3pMODFFaGoyWnY5eXdhbW9idXphVUoxY1pRdTJkbG4K",
      "endpoints": [
        "https://github.com/Hanyer001/antares-actualizaciones/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
